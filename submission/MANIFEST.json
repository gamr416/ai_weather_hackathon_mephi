{
  "team": "ai_weather_hackathon_mephi",
  "task": "ERA5 28-channel AE codec (MEPhI hackathon)",
  "model": {
    "name": "ResidualFSQAE",
    "variant": "A18+",
    "class": "src.models.residual_fsq.ResidualFSQAE",
    "params_M": 19.11,
    "param_limit_M": 20,
    "grid": "0.5deg",
    "shape": [28, 360, 720],
    "channels": 28,
    "raw_cr": 34.5,
    "note": "Larger capacity + more FSQ latents vs 8.46M baseline. Full-frame GPU OOM on 12GB (fine patch-4 attention); reported full-frame metrics via CPU."
  },
  "checkpoint": {
    "path": "submission/artifacts/best.pt",
    "source_run": "runs/residual_fsq_0p5/20260725_212101_n512s40k_A18",
    "train_N": 512,
    "steps": 40000,
    "norm_stats": "submission/artifacts/norm_stats.npz",
    "config": "submission/artifacts/config.yaml"
  },
  "metrics_reported": {
    "sigma": "submission/ref_stats/sigma_official_28ch.npz",
    "full_frame": {
      "protocol": "CPU encode/decode, 32 frames",
      "val": {"S_all": 0.0725, "S_surface": 0.0729, "S_pressure": 0.0722, "file": "submission/metrics/val_metrics.json"},
      "test": {"S_all": 0.0724, "S_surface": 0.0728, "S_pressure": 0.0720, "file": "submission/metrics/test_metrics.json"}
    },
    "crop_160": {
      "protocol": "GPU, crop 160, 128 frames",
      "val": {"S_all": 0.0608, "file": "submission/metrics_crop/val_metrics.json"},
      "test": {"S_all": 0.0605, "file": "submission/metrics_crop/test_metrics.json"}
    },
    "bitstream_val": {
      "mean_cr_official": 38.73,
      "all_exact": true,
      "n_frames": 8,
      "file": "submission/metrics/bitstream_val.json"
    },
    "previous_8p5M_full_test": {"S_all": 0.0788, "run": "n512s35k_ft"}
  },
  "delivery_checklist": {
    "code": true,
    "docker": true,
    "checkpoint": true,
    "bitstream": true,
    "manifest_times": "submission/manifest_times_n512.json",
    "metrics_json": true,
    "quality_vs_N_plot": "submission/plots/quality_vs_N_test.png",
    "quality_vs_bitrate_plot": "submission/plots/quality_vs_bitrate_test.png",
    "probe_6h": "submission/probe_6h/ (from prior 8.5M final; re-run on A18 optional)",
    "scope_0p25": "submission/SCOPE_0p25.md"
  },
  "container": {
    "dockerfile": "Dockerfile",
    "compose": "docker-compose.yml",
    "image": "mephi-era5-residual-fsq:latest",
    "build": "docker build -t mephi-era5-residual-fsq:latest .",
    "run": "docker run --rm -it --gpus all -v $PWD/data:/workspace/data:ro mephi-era5-residual-fsq:latest"
  },
  "resources": {
    "gpu": "RTX 3060 12GB",
    "trainable_params": "19.11M",
    "resolution_delivered": "0.5deg only"
  }
}
